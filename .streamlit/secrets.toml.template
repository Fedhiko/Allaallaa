# Streamlit Cloud Secrets Template
# On Streamlit Cloud, add these as secrets in the app settings dashboard
# For local testing, copy this to ~/.streamlit/secrets.toml

# PostgreSQL Cloud Database (ElephantSQL, AWS RDS, Heroku Postgres, etc.)
host = "your-postgres-host.amazonaws.com"
database = "your_database_name"
user = "your_username"
password = "your_password"
port = 5432

# Optional: API Keys for enhanced features
# Uncomment and fill if you want to use external APIs

# FAO WaPOR API
# wapor_api_key = "your-wapor-api-key"

# OpenWeatherMap API
# openweather_api_key = "your-openweather-api-key"

# SMS Gateway (for Phase 4 Field Operations)
# twilio_account_sid = "your-twilio-account-sid"
# twilio_auth_token = "your-twilio-auth-token"
# twilio_from_number = "+1234567890"

# OR AfricasTalking
# africas_talking_api_key = "your-africas-talking-key"
# africas_talking_username = "your-africas-talking-username"
